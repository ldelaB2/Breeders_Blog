# Postgres - Supabase Transaction Pooler connection, used at runtime (Supabase:
# Project Settings -> Database -> Connection string -> Transaction pooler, port 6543).
# Serverless-safe: bounds each function instance to a small connection footprint.
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Postgres - Supabase direct connection, used only by `prisma migrate` (same
# dashboard page -> Connection string -> Direct connection, port 5432).
DIRECT_URL=postgresql://user:password@db.project-ref.supabase.co:5432/postgres

# Clerk (Clerk Dashboard -> API Keys -> Secret key)
CLERK_SECRET_KEY=

# Clerk webhook signing secret (Clerk Dashboard -> Webhooks -> your endpoint
# -> Signing Secret). Verifies POST /api/webhooks/clerk requests are really
# from Clerk; see src/routes/webhooks.routes.js.
CLERK_WEBHOOK_SIGNING_SECRET=

PORT=4000
# Frontend origin - used in the sitemap and notification email links.
SITE_URL=http://localhost:5173
# Origin(s) allowed to call this API, comma-separated.
CORS_ORIGIN=http://localhost:5173

# Supabase Storage (Supabase Dashboard -> Project Settings -> API for the
# URL/secret key; Storage -> bucket name). Both buckets are private - see the
# README for the one-time bucket settings.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Moderator-stitched HTML, one object per post (postId.html).
SUPABASE_STORAGE_BUCKET=post-html
# Authors' original raw uploads (.md/.qmd/.zip), one folder per post id.
SUPABASE_UPLOAD_BUCKET=post-upload

# Resend (Vercel Marketplace integration; auto-populates RESEND_API_KEY).
# Used for post-workflow notification emails, see src/lib/mail.js.
RESEND_API_KEY=
# "From" address for notification emails. onboarding@resend.dev works with no
# setup; switch to an address on a domain verified in the Resend dashboard.
EMAIL_FROM=Breeders Blog <onboarding@resend.dev>
