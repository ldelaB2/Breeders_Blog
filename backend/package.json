{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "test": "node --env-file=.env.test tests/setup/migrateDb.js && node --env-file=.env.test --test --test-concurrency=1",
    "postinstall": "prisma generate",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then prisma migrate deploy; fi",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@clerk/backend": "^1.21.0",
    "@prisma/client": "^6.2.1",
    "@supabase/storage-js": "^2.109.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "resend": "^6.28.1",
    "svix": "^1.99.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "supertest": "^7.3.0"
  }
}
