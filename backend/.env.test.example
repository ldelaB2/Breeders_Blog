# Settings for `npm test`. Copy to .env.test. The suite only ever talks to
# this local database (tests/setup/guard.js refuses anything else) and swaps
# Clerk, Supabase Storage and Resend for in-memory fakes, so no real keys
# belong here. One-time setup is in the README ("Backend tests").
DATABASE_URL=postgresql://breeders_test:breeders_test@localhost:5432/breeders_test
DIRECT_URL=postgresql://breeders_test:breeders_test@localhost:5432/breeders_test
SITE_URL=http://site.test
